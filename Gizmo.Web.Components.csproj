<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>NETProjects</Authors>
		<Product>Gizmo</Product>
		<OutputType>Library</OutputType>
		<Description>Gizmo shared razor components library.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://www.gizmopowered.net/</PackageProjectUrl>
		<PackageIcon>package_icon.png</PackageIcon>
		<PackageIconUrl />
		<RepositoryUrl>https://github.com/GAMP/Gizmo.Web.Components</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>1.0</Version>
		
		<!--Fixes duplicate file error on publish (.NET6 BUG)-->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Resources\package_icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Gizmo.Shared" Version="1.0.16" />
	</ItemGroup>

	<ItemGroup>
		<!-- Sibling bundles import this file from src\js, so it stays there and is exposed as a linked static web asset. -->
		<Content Include="src\js\chart-tooltip.js" Link="wwwroot\js\chart-tooltip.js" />
	</ItemGroup>
	
</Project>
