@using Gizmo.Web.Components

<div class="container">
    <h1 class="title is-size-1 has-text-centered">Gizmo List</h1>
    <Tabs>
        <ExampleContent>
            <div class="columns">
                <div class="column is-half">
                    <List IsDraggable="true">
                        @foreach (var item in _items)
                        {
                            <ListItem
                                DisplayOrder="@item.DisplayOrder"
                                Class="card has-border-light has-background-blazor has-text-white has-cursor-grab">
                                <p class="is-size-4 p-2 ml-4">@item.Name</p>
                            </ListItem>
                        }
                    </List>
                </div>
            </div>
        </ExampleContent>
    </Tabs>
</div>