{
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.0.0",
    "copyfiles": "^2.4.1",
    "sass-migrator": "^2.3.0"
  },
  "scripts": {
    "build-ts": "tsc",
    "migrate-scss": "sass-migrator module ../Gizmo.Web.Components/src/scss/main.scss",
    "build-css": "sass ../Gizmo.Web.Components/src/scss/main.scss:wwwroot/css/main.css",
    "build": "npm run build-ts && npm run migrate-scss && npm run build-css",
    "watch": "chokidar \"../src/ts/*.ts\" \"./css/*.css\" -c \"npm run build\""
  }
}