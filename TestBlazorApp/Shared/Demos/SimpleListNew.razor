<div class="container">
    <h1 class="title is-size-1 has-text-centered">Simple List New</h1>
    <Tabs>
        <ExampleContent>
            <div class="columns">
                <div class="column is-half">
                    <ul id="sortable-list" class="card has-border-light has-background-blazor has-text-white has-cursor-grab">
                        @foreach(var item in _items)
                        {
                            <li draggable="true">
                                <div class="card has-border-light has-background-blazor has-text-white has-cursor-grab">
                                    <p class="is-size-4 p-2 ml-4">@item.Name</p>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </ExampleContent>
    </Tabs>
</div>